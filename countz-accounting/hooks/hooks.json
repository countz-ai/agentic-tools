{
  "description": "Refuse the MCP tools the Countz account blocks, for the rest of the session, subagents included (hooks/mcp_blocklist.py).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp_blocklist.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*countz__(get_countz_config|update_countz_config)",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mcp_blocklist.py" }
        ]
      }
    ]
  }
}
